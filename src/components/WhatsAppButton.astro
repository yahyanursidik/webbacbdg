---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import MapPin from "@lucide/astro/icons/map-pin";
import MessageCircle from "@lucide/astro/icons/message-circle";
import X from "@lucide/astro/icons/x";
import { whatsappAdmins, whatsappAdminUrl } from "@/data/site";

const message = "Halo Admin BAC, saya ingin konsultasi kebutuhan atribut kedinasan.";
---

<button
  class="floating-whatsapp"
  type="button"
  data-whatsapp-open
  aria-label="Pilih admin WhatsApp BAC"
  aria-haspopup="dialog"
  aria-controls="whatsapp-admin-chooser"
>
  <MessageCircle size={23} strokeWidth={1.9} aria-hidden="true" />
</button>

<dialog
  class="whatsapp-chooser"
  id="whatsapp-admin-chooser"
  aria-labelledby="whatsapp-chooser-title"
  aria-describedby="whatsapp-chooser-description"
>
  <div class="whatsapp-chooser-panel">
    <div class="whatsapp-chooser-heading">
      <span class="whatsapp-chooser-mark" aria-hidden="true">
        <MessageCircle size={22} strokeWidth={1.8} />
      </span>
      <div>
        <p>WhatsApp BAC</p>
        <h2 id="whatsapp-chooser-title">Pilih admin tujuan</h2>
      </div>
      <button
        class="whatsapp-chooser-close"
        type="button"
        data-whatsapp-close
        aria-label="Tutup pilihan admin"
      >
        <X size={20} strokeWidth={1.9} aria-hidden="true" />
      </button>
    </div>

    <p class="whatsapp-chooser-description" id="whatsapp-chooser-description">
      Pilih admin berdasarkan wilayah yang paling sesuai. Isi pesan Anda tetap dibawa ke percakapan.
    </p>

    <div class="whatsapp-admin-list">
      {
        whatsappAdmins.map((admin, index) => (
          <a
            class="whatsapp-admin-option"
            href={whatsappAdminUrl(admin.id, message)}
            target="_blank"
            rel="noreferrer"
            data-wa-direct
            data-wa-admin-option
            data-admin-number={admin.number}
            autofocus={index === 0}
          >
            <span class="whatsapp-admin-icon" aria-hidden="true">
              <MapPin size={21} strokeWidth={1.8} />
            </span>
            <span class="whatsapp-admin-copy">
              <small>Admin {admin.city}</small>
              <strong>{admin.name}</strong>
              <span>{admin.display}</span>
            </span>
            <ArrowUpRight size={19} strokeWidth={1.9} aria-hidden="true" />
          </a>
        ))
      }
    </div>

    <p class="whatsapp-chooser-note">
      Pesan belum terkirim sampai Anda menekan tombol kirim di WhatsApp.
    </p>
  </div>
</dialog>

<script>
  const chooser = document.querySelector<HTMLDialogElement>("#whatsapp-admin-chooser");
  const chooserOptions =
    document.querySelectorAll<HTMLAnchorElement>("[data-wa-admin-option]");
  const defaultMessage =
    "Halo Admin BAC, saya ingin konsultasi kebutuhan atribut kedinasan.";

  const openChooser = (message = defaultMessage) => {
    if (!chooser) return;

    chooserOptions.forEach((option) => {
      const number = option.dataset.adminNumber;
      if (!number) return;
      option.href = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
    });

    if (!chooser.open) chooser.showModal();
  };

  document.querySelectorAll<HTMLElement>("[data-whatsapp-open]").forEach((trigger) => {
    trigger.addEventListener("click", () => openChooser());
  });

  document.addEventListener("click", (event) => {
    if (
      event.defaultPrevented ||
      event.button !== 0 ||
      event.ctrlKey ||
      event.metaKey ||
      event.shiftKey ||
      event.altKey
    ) return;

    const target = event.target as HTMLElement | null;
    const link = target?.closest<HTMLAnchorElement>('a[href*="wa.me/"]');
    if (!link || link.hasAttribute("data-wa-direct")) return;

    event.preventDefault();
    const url = new URL(link.href);
    openChooser(url.searchParams.get("text") || defaultMessage);
  });

  window.addEventListener("bac:open-whatsapp", (event) => {
    const customEvent = event as CustomEvent<{ message?: string }>;
    customEvent.preventDefault();
    openChooser(customEvent.detail?.message || defaultMessage);
  });

  document
    .querySelector<HTMLButtonElement>("[data-whatsapp-close]")
    ?.addEventListener("click", () => chooser?.close());

  chooserOptions.forEach((option) => {
    option.addEventListener("click", () => chooser?.close());
  });

  chooser?.addEventListener("click", (event) => {
    if (event.target === chooser) chooser.close();
  });
</script>
